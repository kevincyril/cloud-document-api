    "/purchases/{id}/returned": {"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"patch":{"tags":["Purchases"],"summary":"Mark returned or active without changing confirmed deadline","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["revision","returned"],"properties":{"revision":{"type":"integer","minimum":1},"returned":{"type":"boolean"}}}}}},"responses":{"200":{"description":"Updated purchase and revision"},"400":{"description":"Invalid input"},"401":{"description":"Sign-in required"},"403":{"description":"Cookie CSRF check failed"},"404":{"description":"Purchase not found"},"409":{"description":"Stale revision"},"429":{"description":"Too many attempts"}}}},

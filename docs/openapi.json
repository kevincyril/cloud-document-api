{
  "openapi": "3.0.3",
  "info": {"title":"Return Keeper API","version":"1.2.0","description":"Private receipt images, browser-submitted OCR, confirmed purchase details and return deadlines, calendar export, and existing PDF/text extraction and page-level search. JWT ownership checks protect documents and purchases. JPEG/PNG receipt OCR runs in the browser; scanned PDF OCR and automatic notifications are not supported. Local implementation awaiting production review."},
  "servers": [{ "url": "/", "description": "Current API host" }],
  "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],

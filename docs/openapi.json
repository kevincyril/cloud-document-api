    "/auth/exchange": {"post":{"tags":["Authentication"],"security":[],"summary":"Exchange a verified Supabase identity for an application session","description":"Available only with AUTH_MODE=supabase. Checks identity with Supabase Auth; requires verified email. Existing accounts require previous workspace password proof before linking. Local database roles and ownership IDs are preserved.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["accessToken"],"properties":{"accessToken":{"type":"string","minLength":1,"maxLength":16000},"legacyPassword":{"type":"string","minLength":1,"maxLength":72}}}}}},"responses":{"200":{"description":"Application token and public user profile"},"400":{"description":"Invalid request"},"401":{"description":"Invalid or unverified identity, or incorrect linking password"},"404":{"description":"Managed authentication disabled"},"409":{"description":"Workspace already linked to another identity"},"428":{"description":"Previous workspace password required; code link_required"},"429":{"description":"Too many attempts"},"503":{"description":"Provider or database unavailable"}}}},
    "/purchases/{id}/calendar": {"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"tags":["Purchases"],"summary":"Download the saved user-confirmed deadline as an all-day calendar event","description":"Authenticated, no-store .ics download. DATE values do not shift with time zones. No email, notification, or alarm is scheduled by this app. Unsaved edits do not change the exported date.","responses":{"200":{"description":"RFC 5545 all-day event","headers":{"Content-Disposition":{"schema":{"type":"string"}}},"content":{"text/calendar":{"schema":{"type":"string"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"description":"No confirmed deadline"},"500":{"$ref":"#/components/responses/InternalError"}}}},

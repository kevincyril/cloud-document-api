    "/auth/logout": {"post":{"tags":["Authentication"],"security":[],"summary":"Clear the browser session cookie","description":"A valid cookie requires its X-CSRF-Token header. Does not revoke copied bearer tokens before their expiry.","responses":{"200":{"description":"Cookie cleared"},"403":{"description":"CSRF check failed"}}}},

# Local development. Copy to .env and fill in credentials privately.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_document_api
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# Optional path to the database provider's CA certificate (TLS stays verified).
# DB_SSL_CA_FILE=
JWT_SECRET=
TRUST_PROXY_HOPS=0
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Deployment: STORAGE_DRIVER=supabase, DB_SSL=true, NODE_ENV=production.
# Copy database host/user from Supabase's SESSION pooler connection dialog.
# Never use the public/anon key here. This credential stays on the server.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=documents
# Optional managed authentication. Keep legacy until providers are configured.
AUTH_MODE=legacy
AUTH_EMAIL_ENABLED=false
AUTH_PUBLIC_ENABLED=false
# Private preview only; comma-separated verified tester emails, configured in Render.
AUTH_ALLOWED_EMAILS=
AUTH_PROVIDERS=
SUPABASE_AUTH_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=

{
  "name": "cloud-document-api",
  "version": "1.0.0",
  "description": "Ownership-protected document uploads, PDF/text extraction, and persisted analysis using Express, PostgreSQL, and private object storage.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/error-handling.test.cjs scripts/rate-limiting.test.cjs scripts/upload-validation.test.cjs scripts/storage.test.cjs scripts/page-extraction.test.cjs",
    "test:integration": "node --test scripts/api.integration.test.cjs scripts/migrations.integration.test.cjs scripts/processing-concurrency.test.cjs scripts/search.integration.test.cjs",
    "test:concurrency": "node --test scripts/processing-concurrency.test.cjs",
    "test:browser": "node --test scripts/browser.test.cjs",
    "docs:check": "node scripts/validate-docs.cjs",
    "check": "npm run typecheck && npm test && npm run docs:check && npm run build",
    "db:migrate": "node scripts/migrate.cjs",
    "db:recover-processing": "node scripts/recover-processing.cjs"
  },
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
